# Runtime environment: development | test | production
NODE_ENV=development
# HTTP port the Nest app listens on
PORT=3000
# pino log level: fatal|error|warn|info|debug|trace
LOG_LEVEL=info
# Host port for the docker-compose Postgres. Change it if 5433 is already
# in use on your machine, and keep DATABASE_URL below in step with it.
DB_PORT=5433
# Postgres connection string
DATABASE_URL=postgresql://triage:triage@localhost:5433/triage?schema=public
# OpenAI API key — leave empty in repo, paste your own locally
OPENAI_API_KEY=
# OpenAI model used by the agent core
OPENAI_MODEL=gpt-4.1-mini
# Timeout in ms for a single LLM call
LLM_TIMEOUT_MS=30000
# When true, bypass the real LLM with a fake/stub implementation
FAKE_LLM=false
# Max reasoning/tool-call iterations per agent turn
MAX_AGENT_ITERATIONS=6
# Max side-effecting tool calls allowed per turn
MAX_SIDE_EFFECTS_PER_TURN=4
# Simulated latency of the mocked downstream tools, in ms
MOCK_TOOL_LATENCY_MS=250
