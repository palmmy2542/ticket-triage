{
  "name": "ticket-triage",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "build": "tsc -p tsconfig.build.json && mkdir -p dist/agent/prompt && cp src/agent/prompt/*.md dist/agent/prompt/",
    "start": "node dist/main.js",
    "start:dev": "node --env-file=.env --watch -r ts-node/register src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest --selectProjects unit",
    "test:e2e": "jest --selectProjects e2e",
    "setup": "prisma migrate deploy",
    "db:test:setup": "bash scripts/setup-test-db.sh",
    "eval": "node --env-file-if-exists=.env -r ts-node/register eval/run.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.3",
    "@nestjs/core": "^11.2.3",
    "@nestjs/platform-fastify": "^11.2.3",
    "@prisma/client": "^6.19.3",
    "nestjs-pino": "^5.1.0",
    "openai": "^7.10.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.4.1",
    "eslint": "^10.10.0",
    "fastify": "5.12.3",
    "jest": "^30.5.1",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "prisma": "6.19.3",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0"
  }
}
